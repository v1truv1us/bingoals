{
  "$schema": "https://schema.tauri.app/config/2.0.0",
  "productName": "Bingoals",
  "version": "0.1.0",
  "identifier": "v1truv1us.bingoals.app",
  "build": {
    "beforeBuildCommand": "bun run build",
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "frontendDist": "dist"
  },
  "app": {
    "windows": [
      {
        "title": "Bingoals",
        "width": 800,
        "height": 600,
        "resizable": true,
        "label": "main"
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}